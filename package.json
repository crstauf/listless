{
  "name": "listless",
  "version": "0.1.0",
  "private": true,
  "description": "Turn an agent's task list into a checklist that lives only in your browser.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build-page.ts",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "screenshots": "npm run build && node scripts/screenshots.ts",
    "typecheck": "tsc -p . && tsc -p scripts && tsc -p test/page",
    "test": "vitest run",
    "test:page": "npm run build && vitest run -c vitest.page.config.ts"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.5",
    "@cloudflare/workers-types": "5.20261019.1",
    "@types/node": "26.6.5",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "wrangler": "4.151.2"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true,
    "fsevents": false
  },
  "engines": {
    "node": ">=24"
  }
}
