{
  "name": "listless",
  "version": "0.1.0",
  "private": true,
  "description": "Turn an agent's task list into a checklist that lives only in your browser.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build-page.ts",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc -p . && tsc -p scripts",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.5",
    "@cloudflare/workers-types": "5.20261019.1",
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "wrangler": "4.151.2"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  }
}
